  "description": "Simple device spectrogram dashboard with Express, Socket.IO, TypeORM, and MySQL",
  "main": "dist/server.js",
  "scripts": {
    "predev": "node scripts/free-port-3111.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "node dist/server.js"
  },
  "keywords": [
    "node",
    "typescript",
    "express",
    "socket.io",
    "typeorm",
