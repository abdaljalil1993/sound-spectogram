<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <h1>Device Spectrogram Dashboard</h1>
      <div class="topbar-actions">
        <nav class="top-nav" id="topNav">
          <button type="button" class="tab-btn active" data-tab="history">History</button>
          <button type="button" class="tab-btn" data-tab="users">User</button>
          <button type="button" class="tab-btn" data-tab="devices">Device</button>
        </nav>
        <span id="socketStatusBadge" class="connection-badge disconnected" title="Socket connection status">Socket: Disconnected</span>
        <span id="userBadge" class="user-badge"></span>
        <button id="logoutBtn" type="button">Logout</button>
      </div>
    </header>

    <main class="main-content">
      <p id="globalMessage" class="global-message"></p>

      <div class="dashboard-layout">
        <section class="left-panel">
          <section id="historyPanel" class="tab-panel active">
            <h2 id="selectedDeviceTitle">Select a device</h2>
            <div class="inline-form range-actions-row">
              <button id="latest24Btn" type="button">Latest 1h</button>
              <button id="loadExampleBtn" type="button">Load Example</button>
              <button id="resetViewBtn" type="button">Reset View</button>
            </div>

            <div class="spectro-toolbar" id="spectroToolbar">
              <button id="panLeftBtn" type="button" class="ghost-btn" title="Pan left (Arrow Left)">Pan Left</button>
              <button id="panRightBtn" type="button" class="ghost-btn" title="Pan right (Arrow Right)">Pan Right</button>
              <button id="zoomOutBtn" type="button" class="ghost-btn" title="Zoom out (-)">Zoom Out</button>
              <button id="zoomInBtn" type="button" class="ghost-btn" title="Zoom in (+)">Zoom In</button>
              <button id="fitPacketsBtn" type="button" class="ghost-btn" title="Fit all packets in view (F)">Fit Packets</button>
              <button id="colorMapBtn" type="button" class="ghost-btn" title="Toggle color map">Colors: magma</button>
              <button id="followLiveBtn" type="button" class="ghost-btn" title="Return to live latest 1h (L)">Follow Live</button>
            </div>
            <div class="frequency-range-controls">
              <label>
                Min Freq (Hz)
                <input id="freqMinInput" type="number" step="1" placeholder="Min Hz" />
              </label>
              <label>
                Max Freq (Hz)
                <input id="freqMaxInput" type="number" step="1" placeholder="Max Hz" />
              </label>
              <button id="applyFreqRangeBtn" type="button" class="ghost-btn">Apply</button>
              <button id="clearFreqRangeBtn" type="button" class="ghost-btn">Clear</button>
            </div>
            <p class="spectro-hint">
              Drag to pan. Mouse wheel zooms at cursor. Shift + wheel pans horizontally. Alt + wheel gives fine zoom.
              Keyboard: Left/Right pan, +/- zoom, 0 reset, F fit packets, L latest 1h.
            </p>

            <div class="canvas-wrapper">
              <div id="spectrogramLoader" class="spectrogram-loader hidden" aria-live="polite">
                <div class="spectrogram-loader-spinner"></div>
                <div class="spectrogram-loader-text">Loading spectrogram data...</div>
              </div>
              <canvas id="spectrogramCanvas" width="960" height="480" tabindex="0" aria-label="Spectrogram viewport"></canvas>
            </div>
            <div id="gapTooltip" class="gap-tooltip hidden"></div>
            <div id="probeTooltip" class="probe-tooltip hidden"></div>
            <div class="legend-wrapper">
              <canvas id="spectrogramLegend" width="560" height="46"></canvas>
            </div>
            <div id="historyInfo" class="history-info">No data loaded.</div>

            <div class="table-wrap history-table-wrap">
              <h3>History Packets</h3>
              <table class="data-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Duration</th>
                    <th>Rows</th>
                    <th>Cols</th>
                  </tr>
                </thead>
                <tbody id="historyTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="usersPanel" class="tab-panel">
            <h2>User Management</h2>
            <form id="userForm" class="crud-form admin-only">
              <input type="hidden" id="userId" />
              <label for="userName">Name</label>
              <input id="userName" name="name" type="text" required />
              <label for="userUsername">Username</label>
              <input id="userUsername" name="username" type="text" required />
              <label for="userPassword">Password</label>
              <input id="userPassword" name="password" type="password" placeholder="Required for add, optional for edit" />
              <label for="userRole">Role</label>
              <select id="userRole" name="role" required>
                <option value="admin">admin</option>
                <option value="emp">emp</option>
              </select>
              <div class="form-actions">
                <button type="submit" id="userSaveBtn">Add User</button>
                <button type="button" id="userCancelBtn">Cancel</button>
              </div>
            </form>
            <p id="userFormMessage" class="history-info"></p>

            <div class="table-wrap">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th class="admin-only">Actions</th>
                  </tr>
                </thead>
                <tbody id="usersTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="devicesPanel" class="tab-panel">
            <h2>Device Management</h2>
            <form id="deviceForm" class="crud-form admin-only">
              <input type="hidden" id="deviceId" />
              <label for="deviceName">Name</label>
              <input id="deviceName" name="name" type="text" required />
              <label for="deviceDescription">Description</label>
              <input id="deviceDescription" name="description" type="text" />
              <label for="deviceMinFrequency">Min Frequency (Hz)</label>
              <input id="deviceMinFrequency" name="minFrequency" type="number" min="0" step="0.01" />
              <label for="deviceMaxFrequency">Max Frequency (Hz)</label>
              <input id="deviceMaxFrequency" name="maxFrequency" type="number" min="0" step="0.01" />
              <div class="form-actions">
                <button type="submit" id="deviceSaveBtn">Add Device</button>
                <button type="button" id="deviceCancelBtn">Cancel</button>
              </div>
            </form>
            <p id="deviceFormMessage" class="history-info"></p>

            <div class="table-wrap">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Freq Range</th>
                    <th class="admin-only">Actions</th>
                  </tr>
                </thead>
                <tbody id="devicesTableBody"></tbody>
              </table>
            </div>
          </section>
        </section>

        <aside class="right-panel">
          <div class="side-card">
            <h3>Device Info</h3>
            <p id="sideDeviceInfo" class="history-info">No selected device.</p>
          </div>

          <div class="side-card">
            <h3>Devices</h3>
            <div class="device-list-scroll">
              <ul id="deviceList" class="device-list"></ul>
            </div>
          </div>

          <div class="side-card">
            <h3>Load Range</h3>
            <form id="historyRangeForm" class="side-range-form">
              <label for="queryDate">Day</label>
              <input id="queryDate" name="queryDate" type="date" required />
              <label for="fromTime">From</label>
              <input id="fromTime" name="fromTime" type="time" step="60" required />
              <label for="toTime">To</label>
              <input id="toTime" name="toTime" type="time" step="60" required />
              <button type="submit">Load Range</button>
            </form>
            <div class="quick-range-grid">
              <button id="latest5hBtn" type="button" class="ghost-btn">Latest 5h</button>
              <button id="latest24hBtn" type="button" class="ghost-btn">Latest 24h</button>
            </div>
            <div class="last-packet-row">
              <button id="latestPacketBtn" type="button" class="ghost-btn">Last Packet</button>
              <button id="stepBack5mBtn" type="button" class="ghost-btn mini-btn" title="Step back 5 minutes">-5m</button>
            </div>
          </div>

          <div class="side-card">
            <h3>Processing Controls</h3>
            <p class="control-note" id="processingStatus">اختر الجهاز ثم عدل الإعدادات. التطبيق يتم مباشرة عند التغيير.</p>
            <div class="processing-controls-grid">
              <label for="intensityModeSelect">Scale Mode</label>
              <select id="intensityModeSelect" class="toolbar-select" title="Intensity scale mode">
                <option value="linear">Linear (صورة intensity)</option>
                <option value="db-fixed">dB fixed clip</option>
                <option value="db-percentile">dB percentile</option>
              </select>

              <label for="dbMinInput">dB Min</label>
              <input id="dbMinInput" class="toolbar-number" type="number" step="1" value="-95" title="dB minimum clip" />

              <label for="dbMaxInput">dB Max</label>
              <input id="dbMaxInput" class="toolbar-number" type="number" step="1" value="-20" title="dB maximum clip" />

              <label for="pctLowInput">dB Percentile Low</label>
              <input id="pctLowInput" class="toolbar-number" type="number" min="0" max="99" step="1" value="5" title="Percentile low" />

              <label for="pctHighInput">dB Percentile High</label>
              <input id="pctHighInput" class="toolbar-number" type="number" min="1" max="100" step="1" value="99" title="Percentile high" />

              <label for="compareViewSelect">View Compare</label>
              <select id="compareViewSelect" class="toolbar-select" title="Compare processing stage">
                <option value="denoised">Denoised</option>
                <option value="original">Original</option>
                <option value="thresholded">Thresholded</option>
              </select>

              <label class="toolbar-check" title="Enable adaptive noise suppression">
                <input id="noiseSuppressionEnabledInput" type="checkbox" checked /> Noise Gate
              </label>
              <input
                id="noiseFloorPercentileInput"
                class="toolbar-number"
                type="number"
                min="1"
                max="99"
                step="1"
                value="72"
                title="Noise floor percentile"
              />

              <label for="noiseThresholdInput">Noise Threshold</label>
              <input id="noiseThresholdInput" class="toolbar-number" type="number" min="0" max="1" step="0.01" value="0.06" title="Minimum normalized threshold" />

              <label class="toolbar-check" title="Remove isolated active pixels using neighborhood test">
                <input id="isolatedPixelRemovalEnabledInput" type="checkbox" checked /> De-speckle
              </label>
              <input id="minActiveNeighborsInput" class="toolbar-number" type="number" min="0" max="8" step="1" value="1" title="Minimum active neighbors" />

              <label for="neighborhoodSizeSelect">Neighborhood</label>
              <select id="neighborhoodSizeSelect" class="toolbar-select" title="Neighborhood size">
                <option value="3" selected>3x3</option>
                <option value="5">5x5</option>
              </select>

              <label for="bucketAggregationSelect">Bucket Aggregation</label>
              <select id="bucketAggregationSelect" class="toolbar-select" title="Column aggregation when compressed">
                <option value="max" selected>max</option>
                <option value="hybrid">hybrid</option>
              </select>

              <label class="toolbar-check" title="Show render statistics for current visible data">
                <input id="debugStatsEnabledInput" type="checkbox" /> Show Stats
              </label>
              <button id="applyIntensityBtn" type="button" class="ghost-btn" title="Apply intensity scaling">Apply Scale</button>
              <button id="applyNoiseBtn" type="button" class="ghost-btn" title="Apply noise suppression settings">Apply Noise</button>
            </div>

            <ul class="control-help-list">
              <li><strong>Linear:</strong> مناسب لبيانات الصورة (0..1 أو 0..255). الافتراضي الموصى به لحالتك.</li>
              <li><strong>dB fixed / dB percentile:</strong> تعمل فعليا فقط عندما نوع الإدخال magnitude/db، وإلا يعود النظام تلقائيا لـ Linear.</li>
              <li><strong>Noise Gate:</strong> يزيل الخلفية الضعيفة حسب عتبة تكيفية.</li>
              <li><strong>Noise Floor Percentile:</strong> يحدد أرضية الضجيج من توزيع البيانات (مثلا 72 يعني قيم أقل من ذلك غالبا ضجيج).</li>
              <li><strong>Noise Threshold:</strong> حد أدنى ثابت بعد التطبيع لضبط شدة القص.</li>
              <li><strong>De-speckle + Min neighbors:</strong> يزيل النقاط المنفردة ويحافظ على الخطوط.</li>
              <li><strong>View Compare:</strong> Original قبل المعالجة، Thresholded بعد البوابة، Denoised بعد إزالة النقاط.</li>
              <li><strong>Bucket Aggregation:</strong> max يحافظ على القمم، hybrid يخفف تضخيم النقط المفردة عند ضغط الأعمدة.</li>
            </ul>
          </div>
        </aside>
      </div>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/js/spectrogram.js"></script>
    <script src="/public/js/dashboard.js"></script>
  </body>
</html>
